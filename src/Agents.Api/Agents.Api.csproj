<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>0FFBCECC-C64D-4ED0-B9C8-E8AC3A49FB98</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Agents.Evals.Infrastructure is the only one of these that needs internals today: it owns
          AgentContract and EvalServices, which reach into the agent's registration so the two
          suites do not have to. The suites keep their entries because each still composes the
          production agent for its own layer.
        -->
        <InternalsVisibleTo Include="Agents.Evals.Infrastructure" />
        <InternalsVisibleTo Include="Agents.Api.Evals" />
        <InternalsVisibleTo Include="Agents.Extensions.Evals" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
        <PackageReference Include="Microsoft.Agents.AI" Version="1.19.0" />
        <PackageReference Include="Microsoft.Agents.AI.AGUI" Version="1.13.0-preview.260703.1" />
        <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.19.0-preview.260822.1" />
        <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.19.0" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    </ItemGroup>

</Project>
