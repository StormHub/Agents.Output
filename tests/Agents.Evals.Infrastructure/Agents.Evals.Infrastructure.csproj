<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!--
          A library, not a test project: it carries no xunit reference and no test framework, so
          neither suite inherits a runner it does not want, and nothing here can quietly become a
          test.
        -->
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Agents.Api is a Microsoft.NET.Sdk.Web project, so the ASP.NET Core framework reference
          does not flow transitively to this Microsoft.NET.Sdk project. Declare it explicitly.
        -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\..\src\Agents.Api\Agents.Api.csproj" />
    </ItemGroup>

</Project>
