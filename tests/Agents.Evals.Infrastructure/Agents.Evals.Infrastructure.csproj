<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Reporting only: EvalReport renders a measured run through the framework's own JSON and
          HTML writers. The judging libraries (Quality, NLP, Safety) stay out — each suite brings
          the evaluators it grades with, and keeps its own verdicts. This project supplies the
          mechanism for turning a sample into a verdict; the policy, which floor and which check,
          stays in the suite.
        -->
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Quality" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="10.9.0" />
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation.NLP" Version="10.9.0-preview.1.26411.16" />
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Safety" Version="10.9.0-preview.1.26411.16" />        
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
          Agents.Api is a Microsoft.NET.Sdk.Web project, so the ASP.NET Core framework reference
          does not flow transitively to this Microsoft.NET.Sdk project. Declare it explicitly —
          Microsoft.Extensions.Configuration.{EnvironmentVariables,UserSecrets,Binder} and the DI
          container all arrive with it.
        -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\..\src\Agents.Api\Agents.Api.csproj" />
    </ItemGroup>

</Project>
