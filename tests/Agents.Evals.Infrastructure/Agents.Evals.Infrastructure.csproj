<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!--
          xunit.v3 test projects are executables. This project is both: a library the two suites
          reference, and a runnable suite of its own for the gate arithmetic in Probabilistic/.
          That arithmetic decides whether a live run goes red, so it gets tested rather than
          trusted — and its tests belong beside it, not in whichever suite happens to call it.
        -->
        <OutputType>Exe</OutputType>
        <!--
          One secrets store for both suites, because they read the same keys. Storing EVAL_API_KEY
          once here (see the README for the dotnet user-secrets command) configures the live tiers
          of Agents.Api.Evals and Agents.Extensions.Evals alike.

          Kept distinct from Agents.Api's own store, so an evaluation override can never be
          mistaken for a production setting.
        -->
        <UserSecretsId>2C5C0B41-6E92-4B0F-9F2D-1D6E0D3A7C84</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!--
          Reporting only: EvalReport renders a measured run through the framework's own JSON and
          HTML writers. The judging libraries (Quality, NLP, Safety) stay out — each suite brings
          the evaluators it grades with, and keeps its own verdicts. This project supplies the
          mechanism for turning a sample into a verdict; the policy, which floor and which check,
          stays in the suite.
        -->
        <PackageReference Include="Microsoft.Extensions.AI.Evaluation.Reporting" Version="10.9.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!--
          Agents.Api is a Microsoft.NET.Sdk.Web project, so the ASP.NET Core framework reference
          does not flow transitively to this Microsoft.NET.Sdk project. Declare it explicitly —
          Microsoft.Extensions.Configuration.{EnvironmentVariables,UserSecrets,Binder} and the DI
          container all arrive with it.
        -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\..\src\Agents.Api\Agents.Api.csproj" />
    </ItemGroup>

</Project>
